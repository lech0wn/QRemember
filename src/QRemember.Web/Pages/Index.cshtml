@page
@{
    ViewData["Title"] = "QRemember — Preserve the Narrative";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --accent: #B8975A;
            --bg: #FAF9F6;
            --text: #1C1C1C;
            --muted: #8C8C8C;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background: var(--bg);
            -webkit-font-smoothing: antialiased;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .wrap {
            max-width: 1180px;
            margin: 0 auto;
            padding: 0 32px;
        }

        .eyebrow {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent);
        }

        /* ---------- Nav ---------- */
        .site-nav {
            position: sticky;
            top: 0;
            z-index: 20;
            background: var(--bg);
            border-bottom: 1px solid rgba(28, 28, 28, 0.08);
        }

        .site-nav .wrap {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 76px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            font-size: 14px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .brand-logo {
            height: 34px;
            width: auto;
            object-fit: contain;
            flex-shrink: 0;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 36px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .nav-links a {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text);
        }

        .nav-links a:hover {
            color: var(--accent);
        }

        .nav-links .nav-cta {
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .nav-toggle {
            display: none;
        }

        /* ---------- Buttons ---------- */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 15px 28px;
            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--text);
            color: var(--bg);
        }

        .btn-primary:hover {
            background: #333;
        }

        .btn-outline {
            background: transparent;
            color: var(--text);
            border-color: rgba(28, 28, 28, 0.35);
        }

        .btn-outline:hover {
            border-color: var(--text);
        }

        /* ---------- Hero ---------- */
        .hero {
            padding: 88px 0 110px;
        }

        .hero .wrap {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 64px;
            align-items: center;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-weight: 500;
            font-size: 46px;
            line-height: 1.15;
            margin: 18px 0 20px;
        }

        .hero p {
            font-size: 15px;
            line-height: 1.7;
            color: var(--muted);
            max-width: 420px;
            margin: 0 0 32px;
        }

        .hero-media img {
            width: 100%;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            box-shadow: 0 30px 70px rgba(28, 28, 28, 0.18);
        }

        /* ---------- How it works ---------- */
        .section {
            padding: 90px 0;
        }

        .section-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 56px;
            border-bottom: 1px solid rgba(28, 28, 28, 0.1);
            padding-bottom: 28px;
        }

        .section-header h2 {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-weight: 500;
            font-size: 32px;
            margin: 0;
        }

        .steps {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
        }

        .step-num {
            width: 46px;
            height: 46px;
            border: 1px solid rgba(28, 28, 28, 0.25);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Playfair Display', serif;
            font-style: italic;
            color: var(--accent);
            font-size: 14px;
            margin-bottom: 22px;
        }

        .step h3 {
            font-size: 15px;
            font-weight: 700;
            margin: 0 0 10px;
        }

        .step p {
            font-size: 13.5px;
            line-height: 1.7;
            color: var(--muted);
            margin: 0;
        }

        /* ---------- Features ---------- */
        .features .wrap {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 72px;
            align-items: center;
        }

        .features-copy .eyebrow {
            display: block;
            margin-bottom: 14px;
        }

        .features-copy h2 {
            font-family: 'Playfair Display', serif;
            font-weight: 500;
            font-size: 38px;
            line-height: 1.2;
            margin: 0 0 40px;
        }

        .feature-item {
            display: flex;
            gap: 20px;
            padding: 22px 0;
            border-top: 1px solid rgba(28, 28, 28, 0.1);
        }

        .feature-item:last-child {
            padding-bottom: 0;
        }

        .feature-icon {
            width: 22px;
            height: 22px;
            flex-shrink: 0;
            color: var(--text);
        }

        .feature-item h3 {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin: 0 0 8px;
        }

        .feature-item p {
            font-size: 13.5px;
            line-height: 1.7;
            color: var(--muted);
            margin: 0;
        }

        .features-media {
            position: relative;
        }

        .features-media img {
            width: 100%;
            aspect-ratio: 4 / 3.4;
            object-fit: cover;
        }

        .features-card {
            position: absolute;
            left: 24px;
            right: 24px;
            bottom: 24px;
            background: var(--bg);
            padding: 20px 24px;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
        }

        .features-card .eyebrow {
            display: block;
            margin-bottom: 8px;
        }

        .features-card blockquote {
            margin: 0 0 6px;
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 18px;
        }

        .features-card p {
            margin: 0;
            font-size: 12px;
            color: var(--muted);
        }

        /* ---------- CTA ---------- */
        .cta {
            text-align: center;
            padding: 100px 0 110px;
        }

        .cta-icon {
            width: 40px;
            height: 40px;
            color: var(--accent);
            margin: 0 auto 24px;
        }

        .cta h2 {
            font-family: 'Playfair Display', serif;
            font-weight: 500;
            font-size: 36px;
            line-height: 1.25;
            max-width: 640px;
            margin: 0 auto 20px;
        }

        .cta p {
            font-size: 15px;
            line-height: 1.7;
            color: var(--muted);
            max-width: 480px;
            margin: 0 auto 36px;
        }

        .cta-actions {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
        }

        /* ---------- Footer ---------- */
        .site-footer {
            background: var(--text);
            color: rgba(250, 249, 246, 0.65);
            padding: 64px 0 28px;
        }

        .footer-top {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            padding-bottom: 44px;
        }

        .footer-brand {
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            font-size: 14px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--bg);
            margin-bottom: 14px;
        }

        .footer-top p {
            font-size: 13px;
            line-height: 1.7;
            max-width: 260px;
            margin: 0;
        }

        .footer-col h4 {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(250, 249, 246, 0.4);
            margin: 0 0 18px;
        }

        .footer-col ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-col a {
            font-size: 13px;
            color: rgba(250, 249, 246, 0.75);
        }

        .footer-col a:hover {
            color: var(--bg);
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid rgba(250, 249, 246, 0.12);
            padding-top: 22px;
            font-size: 11px;
            letter-spacing: 0.5px;
            color: rgba(250, 249, 246, 0.4);
        }

        @@media (max-width: 900px) {
            .nav-links { display: none; }
            .hero .wrap { grid-template-columns: 1fr; }
            .hero-media { order: -1; }
            .steps { grid-template-columns: repeat(2, 1fr); }
            .features .wrap { grid-template-columns: 1fr; }
            .footer-top { grid-template-columns: 1fr 1fr; }
        }

        @@media (max-width: 520px) {
            .hero h1 { font-size: 34px; }
            .steps { grid-template-columns: 1fr; }
            .section-header { flex-direction: column; align-items: flex-start; gap: 10px; }
            .cta-actions { flex-direction: column; }
            .footer-top { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column; gap: 10px; text-align: center; }
        }
    </style>
</head>
<body>

    <header class="site-nav">
        <div class="wrap">
            <a href="#hero" class="brand">
                <img src="~/images/logo.png" alt="QRemember logo" class="brand-logo" />
                QRemember
            </a>
            <ul class="nav-links">
                <li><a href="#how-it-works">How It Works</a></li>
                <li><a href="#features">Features</a></li>
                <li><a class="nav-cta" href="/Shared/Onboarding/Register">Create Event</a></li>
            </ul>
        </div>
    </header>

    <section class="hero" id="hero">
        <div class="wrap">
            <div class="hero-copy">
                <span class="eyebrow">Preserve the Narrative</span>
                <h1>Save every memory from your event.</h1>
                <p>A simple way for guests to share photos without an app. Just scan, snap, and upload.</p>
                <a href="/Shared/Onboarding/Register" class="btn btn-primary">Create Your Event</a>
            </div>
            <div class="hero-media">
                <img src="~/images/landing-page.png" alt="A printed QR code stand surrounded by flowers at an event" />
            </div>
        </div>
    </section>

    <section class="section" id="how-it-works">
        <div class="wrap">
            <div class="section-header">
                <h2>How it Works</h2>
                <span class="eyebrow">Simple Steps For a Seamless Experience</span>
            </div>
            <div class="steps">
                <div class="step">
                    <div class="step-num">01</div>
                    <h3>Create an event</h3>
                    <p>Set up your digital gallery page in seconds with just a few clicks.</p>
                </div>
                <div class="step">
                    <div class="step-num">02</div>
                    <h3>Print your QR code</h3>
                    <p>Generate a custom design to put on tables, signs, or greeting cards.</p>
                </div>
                <div class="step">
                    <div class="step-num">03</div>
                    <h3>Guests scan and share</h3>
                    <p>Friends scan the code to upload their candid photos instantly from any phone.</p>
                </div>
                <div class="step">
                    <div class="step-num">04</div>
                    <h3>Keep the memories</h3>
                    <p>Everyone gets to see, relive, and download high-resolution photos later.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section features" id="features">
        <div class="wrap">
            <div class="features-copy">
                <span class="eyebrow">Features Designed for You</span>
                <h2>Sophisticated technology made simple.</h2>

                <div class="feature-item">
                    <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="6" width="18" height="14" rx="2"></rect>
                        <path d="M8 6l2-3h4l2 3"></path>
                        <line x1="3" y1="3" x2="21" y2="21"></line>
                    </svg>
                    <div>
                        <h3>No App Needed</h3>
                        <p>Guests share directly from their mobile browser. No downloads, no barriers, just memories.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                        <path d="M3 15l5-5 4 4 5-6 4 5"></path>
                    </svg>
                    <div>
                        <h3>High-Quality</h3>
                        <p>Preserve your event's story in full resolution. No compression, just professional clarity.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="12" rx="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                    <div>
                        <h3>Live Gallery</h3>
                        <p>Watch the photos roll in as they happen on a beautifully curated live feed.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="4" x2="5" y2="20"></line>
                        <line x1="12" y1="4" x2="12" y2="20"></line>
                        <line x1="19" y1="4" x2="19" y2="20"></line>
                        <circle cx="5" cy="9" r="1.6" fill="currentColor" stroke="none"></circle>
                        <circle cx="12" cy="15" r="1.6" fill="currentColor" stroke="none"></circle>
                        <circle cx="19" cy="7" r="1.6" fill="currentColor" stroke="none"></circle>
                    </svg>
                    <div>
                        <h3>Easy Management</h3>
                        <p>Robust host controls to curate content, manage permissions, and download entire albums.</p>
                    </div>
                </div>
            </div>

            <div class="features-media">
                <img src="~/images/landing-page.png" alt="Guests sharing photos from an event" />
                <div class="features-card">
                    <span class="eyebrow">Collection: Moments</span>
                    <blockquote>"The shared perspective"</blockquote>
                    <p>An effortless transition from physical experience to digital archive.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="cta" id="pricing">
        <div class="wrap">
            <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                <circle cx="12" cy="12" r="9"></circle>
                <circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none"></circle>
                <path d="M12 3v3.2M21 12h-3.2M12 21v-3.2M3 12h3.2M18.4 5.6l-2.3 2.3M18.4 18.4l-2.3-2.3M5.6 18.4l2.3-2.3M5.6 5.6l2.3 2.3"></path>
            </svg>
            <h2>Ready to capture your event?</h2>
            <p>Join thousands of hosts making photo sharing effortless. Create your private event gallery in seconds.</p>
            <div class="cta-actions">
                <a href="/Shared/Onboarding/Register" class="btn btn-primary">Start Your Event</a>
                <a href="mailto:hello@qremember.com" class="btn btn-outline">Talk to an Expert</a>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="wrap">
            <div class="footer-top">
                <div>
                    <div class="footer-brand">QRemember</div>
                    <p>Curating life's most significant chapters through effortless, sophisticated digital preservation.</p>
                </div>
                <div class="footer-col">
                    <h4>Product</h4>
                    <ul>
                        <li><a href="#pricing">Pricing</a></li>
                        <li><a href="#">Business</a></li>
                        <li><a href="#">Gallery</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 QRemember Inc. All rights reserved.</span>
            </div>
        </div>
    </footer>

</body>
</html>
