@page "/Guest/GuestEventGallery/"
@model QRemember.Web.Pages.Guest.GuestEventGalleryModel
@{
    Layout = null;
    ViewData["Title"] = Model.EventName;

    var photos = Model.Photos?.ToList() ?? new List<GuestEventGalleryModel.GalleryPhoto>();
    var hasHeroImage = !string.IsNullOrWhiteSpace(Model.HeroImageUrl);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/gallery.min.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_HeroSection", new { Model.EventName, Model.EventDateDisplay, Model.OrganizerDisplayName, Model.EventDescription, Model.EventCode, Model.HeroImageUrl })

    <main class="gallery">
        <div class="gallery-header">
            <h2>Gallery</h2>
            <span class="photo-count">@photos.Count photo@(photos.Count != 1 ? "s" : "")</span>
        </div>

        @if (photos.Count == 0)
        {
            @await Html.PartialAsync("_EmptyGallery", new { EventCode = Model.EventCode })
        }
        else
        {
            @await Html.PartialAsync("_PhotoGrid", photos)
        }
    </main>

    <script src="~/js/gallery.min.js" asp-append-version="true"></script>
</body>
</html>