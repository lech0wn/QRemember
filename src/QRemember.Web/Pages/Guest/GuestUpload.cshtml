@page "{code?}"
@model QRemember.Web.Pages.Guest.GuestUploadModel
@using QRemember.Web.Models.ViewModels
@{
    Layout = null;
    var isEventFound = Model.EventFound && !string.IsNullOrWhiteSpace(Model.EventCode);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@(isEventFound ? $"Share Photos — {Model.EventName}" : "Find Your Event")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/upload.min.css" asp-append-version="true" />
</head>
<body>
    <div class="page-container">
        @await Html.PartialAsync("_BrandHeader")

        @if (isEventFound)
        {
            @await Html.PartialAsync("_UploadForm", new UploadFormModel
            {
                EventName = Model.EventName,
                EventHashtag = Model.EventHashtag,
                EventCode = Model.EventCode,
                MaxPhotos = Model.MaxPhotos
            })
        }
        else
        {
            @await Html.PartialAsync("_QrScanner", new { Model.ErrorMessage })
        }

        <form id="antiforgeryForm">@Html.AntiForgeryToken()</form>
    </div>

    <script>
        // upload.min.js reads these globals to decide whether to boot the
        // upload-mode UI or the QR-scanner UI. They were never being set,
        // so the page always fell through to the scanner branch.
        window.__IS_EVENT_FOUND__ = @Html.Raw(isEventFound ? "true" : "false");
        window.__MAX_PHOTOS__ = @Model.MaxPhotos;
        window.__EVENT_CODE__ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EventCode ?? ""));
    </script>

    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    <script src="~/js/upload.min.js" asp-append-version="true"></script>
</body>
</html>
