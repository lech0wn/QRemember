@page "{code?}"
@model QRemember.Web.Pages.GuestUploadModel
@{
    Layout = null;
    var isEventFound = Model.EventFound && !string.IsNullOrWhiteSpace(Model.EventCode);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@(isEventFound ? $"Share Photos — {Model.EventName}" : "Find Your Event")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-primary: #C5A059;
            --brand-hover: #B28E46;
            --brand-light: #FBF8F2;
            --surface-bg: #FAF9F6;
            --card-bg: #FFFFFF;
            --text-dark: #1A1A1A;
            --text-muted: #71717A;
            --border-color: #E4E4E7;
            --danger: #E11D48;
            --success: #16A34A;
            --radius-xl: 20px;
            --radius-lg: 12px;
            --radius-md: 8px;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
            --shadow-md: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background-color: var(--surface-bg);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-dark);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 32px 16px 64px;
        }

        .page-container {
            width: 100%;
            max-width: 460px;
        }

        /* Header / Brand */
        .brand-header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 32px;
        }

        .brand-header img {
            width: 36px;
            height: 36px;
            object-fit: contain;
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 22px;
            letter-spacing: 1.5px;
            color: var(--text-dark);
            text-transform: uppercase;
        }

        /* Titles Block */
        .page-title {
            text-align: center;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 32px;
            color: var(--brand-primary);
            margin: 0 0 6px;
            line-height: 1.2;
        }

        .page-subtitle {
            text-align: center;
            font-size: 14px;
            color: var(--text-muted);
            margin: 0 0 24px;
        }

        .event-tag {
            text-align: center;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            font-size: 18px;
            color: var(--brand-primary);
            margin: -12px 0 28px;
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 24px;
        }

        .field-label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: var(--text-dark);
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .field-hint {
            display: block;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .guest-input {
            width: 100%;
            border: 1px solid var(--border-color);
            background: var(--card-bg);
            border-radius: var(--radius-md);
            padding: 12px 14px;
            font-family: inherit;
            font-size: 14px;
            color: var(--text-dark);
            transition: all 0.2s ease;
            box-shadow: var(--shadow-sm);
        }

        .guest-input:focus {
            outline: none;
            border-color: var(--brand-primary);
            box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.15);
        }

        /* Dropzone Component */
        .dropzone-card {
            width: 100%;
            background: var(--card-bg);
            border: 2px dashed var(--brand-primary);
            border-radius: var(--radius-xl);
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: var(--shadow-md);
        }

        .dropzone-card:hover,
        .dropzone-card.drag-over {
            background: var(--brand-light);
            transform: translateY(-2px);
        }

        .dropzone-icon {
            width: 48px;
            height: 48px;
            color: var(--brand-primary);
        }

        .dropzone-title {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--text-dark);
        }

        .dropzone-sub {
            font-size: 12px;
            color: var(--text-muted);
        }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
        }

        /* Status & Gallery Bar */
        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-muted);
        }

        .status-bar.limit-reached {
            color: var(--danger);
        }

        .gallery-link {
            font-size: 13px;
            font-weight: 600;
            color: var(--brand-primary);
            text-decoration: none;
            transition: color 0.15s ease;
        }

        .gallery-link:hover {
            color: var(--brand-hover);
        }

        /* Photo Preview Grid */
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 20px;
        }

        .photo-tile {
            position: relative;
            aspect-ratio: 1;
            border-radius: var(--radius-lg);
            overflow: hidden;
            background: #E4E4E7;
            box-shadow: var(--shadow-sm);
        }

        .photo-tile img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .delete-tile-btn {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: none;
            background: rgba(0, 0, 0, 0.65);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            backdrop-filter: blur(4px);
            transition: background 0.15s ease;
        }

        .delete-tile-btn:hover {
            background: var(--danger);
        }

        /* Submit / Upload CTA */
        .btn-primary {
            width: 100%;
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: var(--brand-primary);
            color: #FFFFFF;
            border: none;
            border-radius: 999px;
            padding: 14px 24px;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(197, 160, 89, 0.35);
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            background: var(--brand-hover);
            transform: translateY(-1px);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* Spinner & Progress */
        .spinner {
            display: none;
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: #FFFFFF;
            animation: spin 0.8s linear infinite;
        }

        .btn-primary.loading .spinner { display: inline-block; }
        .btn-primary.loading .btn-text { display: none; }

        @@keyframes spin { to { transform: rotate(360deg); } }

        .progress-container {
            margin-top: 16px;
            text-align: center;
            font-size: 13px;
            color: var(--text-muted);
        }

        .progress-bar-bg {
            width: 100%;
            height: 6px;
            background: #E4E4E7;
            border-radius: 3px;
            margin-top: 8px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--brand-primary);
            width: 0%;
            transition: width 0.3s ease;
        }

        .toast-message {
            margin-top: 16px;
            text-align: center;
            font-size: 13px;
            font-weight: 600;
            min-height: 18px;
        }

        .toast-message.error { color: var(--danger); }
        .toast-message.success { color: var(--success); }

        /* QR Scanner Dark Shell */
        .scan-card {
            background: #18181B;
            border-radius: var(--radius-xl);
            padding: 32px 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 18px;
            color: #FFFFFF;
            box-shadow: var(--shadow-md);
        }

        .scan-card.drag-over {
            box-shadow: 0 0 0 3px var(--brand-primary);
        }

        .scan-card-icon {
            color: var(--brand-primary);
        }

        .scan-card-title {
            color: #E4E4E7;
            font-size: 14px;
            margin: 0;
            text-align: center;
        }

        .scan-action-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #FFFFFF;
            color: #18181B;
            border: none;
            border-radius: 999px;
            padding: 12px 20px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .scan-action-btn:hover {
            background: var(--brand-primary);
            color: #FFFFFF;
        }

        .scan-action-btn--ghost {
            background: transparent;
            border: 1px solid #3F3F46;
            color: #FFFFFF;
        }

        .scan-action-btn--ghost:hover {
            background: #27272A;
        }

        .divider {
            color: #52525B;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .code-input {
            width: 100%;
            background: #27272A;
            border: 1px solid #3F3F46;
            border-radius: var(--radius-lg);
            padding: 12px 16px;
            color: #FFFFFF;
            font-family: inherit;
            font-size: 15px;
            text-align: center;
            letter-spacing: 2px;
            transition: border-color 0.2s ease;
        }

        .code-input::placeholder {
            color: #71717A;
            letter-spacing: normal;
        }

        .code-input:focus {
            outline: none;
            border-color: var(--brand-primary);
        }

        .camera-viewport {
            position: relative;
            width: 100%;
            display: none;
        }

        .camera-viewport.is-active {
            display: block;
        }

        .camera-viewport video {
            width: 100%;
            border-radius: var(--radius-lg);
            background: #000000;
        }

        .camera-frame {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: min(200px, 60%);
            aspect-ratio: 1;
            border: 2px solid var(--brand-primary);
            border-radius: var(--radius-md);
            box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.4);
            pointer-events: none;
        }

        @@media (max-width: 420px) {
            .page-title { font-size: 26px; }
            .dropzone-card { padding: 32px 16px; }
            .photo-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; }
        }
    </style>
</head>
<body>
    <div class="page-container">
        <!-- Brand Header -->
        <header class="brand-header">
            <img src="~/images/logo.png" alt="QRemember Logo" />
            <span class="brand-title">QRemember</span>
        </header>

        @if (isEventFound)
        {
            <!-- PHOTO UPLOAD MODE -->
            <main>
                <h1 class="page-title">Share Photos</h1>
                <p class="page-subtitle">Upload your photos to <strong>@Model.EventName</strong></p>
                <div class="event-tag">#@Model.EventHashtag</div>

                <div class="form-group">
                    <label class="field-label" for="guestName">Guest Name (Optional)</label>
                    <span class="field-hint">Leave blank for anonymous contribution</span>
                    <input type="text" id="guestName" class="guest-input" placeholder="Your name..." autocomplete="name" maxlength="80" />
                </div>

                <div class="dropzone-card" id="dropzone" tabindex="0" role="button" aria-label="Choose photos to upload">
                    <svg class="dropzone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    <span class="dropzone-title">CHOOSE PHOTOS</span>
                    <span class="dropzone-sub">or drag & drop images here</span>
                    <input type="file" id="fileInput" class="visually-hidden" accept="image/*" multiple />
                </div>

                <div class="status-bar" id="statusBar">
                    <span id="selectionCount">0 of @Model.MaxPhotos photos</span>
                    <a href="/Guest/GuestEventGallery?code=@Model.EventCode" class="gallery-link">View Gallery →</a>
                </div>

                <div class="photo-grid" id="photoGrid"></div>

                <button type="button" class="btn-primary" id="submitBtn" hidden>
                    <span class="spinner"></span>
                    <span class="btn-text">Submit Photos</span>
                </button>

                <div class="progress-container" id="uploadProgress" style="display:none;">
                    <span id="progressText">Uploading...</span>
                    <div class="progress-bar-bg">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                </div>

                <p class="toast-message" id="toast" role="status" aria-live="polite"></p>
            </main>
        }
        else
        {
            <!-- QR SCANNER MODE -->
            <main>
                <h1 class="page-title">Find Your Event</h1>
                <p class="page-subtitle">Scan an event QR code or enter your code below</p>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <p class="toast-message error">@Model.ErrorMessage</p>
                }

                <div class="scan-card" id="scanBox" tabindex="0">
                    <svg class="scan-card-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"></path>
                        <rect x="7" y="7" width="10" height="10" rx="1"></rect>
                    </svg>
                    <p class="scan-card-title">Scan the event QR code</p>

                    <div class="camera-viewport" id="cameraContainer">
                        <video id="cameraVideo" playsinline muted></video>
                        <canvas id="cameraCanvas" hidden></canvas>
                        <div class="camera-frame"></div>
                        <button type="button" class="scan-action-btn scan-action-btn--ghost" id="cancelCameraBtn" style="margin-top:12px;">Cancel</button>
                    </div>

                    <button type="button" class="scan-action-btn" id="scanCameraBtn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                        Scan QR Code
                    </button>

                    <span class="divider">— OR —</span>

                    <input type="text" id="eventCodeInput" class="code-input" placeholder="Enter event code" maxlength="50" />

                    <button type="button" class="scan-action-btn" id="manualEntryBtn">Find Event</button>

                    <input type="file" id="qrFileInput" accept="image/*" class="visually-hidden" />
                </div>

                <p class="toast-message" id="statusMsg" role="status" aria-live="polite"></p>
            </main>
        }

        <form id="antiforgeryForm">@Html.AntiForgeryToken()</form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    <script>
        (function () {
            "use strict";

            const isEventFound = @Json.Serialize(isEventFound);

            function getAntiforgeryToken() {
                const el = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]');
                return el ? el.value : "";
            }

            if (isEventFound) {
                const MAX_PHOTOS = @Model.MaxPhotos;
                const EVENT_CODE = @Html.Raw(Json.Serialize(Model.EventCode));

                const dropzone = document.getElementById("dropzone");
                const fileInput = document.getElementById("fileInput");
                const photoGrid = document.getElementById("photoGrid");
                const selectionCount = document.getElementById("selectionCount");
                const statusBar = document.getElementById("statusBar");
                const submitBtn = document.getElementById("submitBtn");
                const toast = document.getElementById("toast");
                const guestNameInput = document.getElementById("guestName");
                const uploadProgress = document.getElementById("uploadProgress");
                const progressFill = document.getElementById("progressFill");
                const progressText = document.getElementById("progressText");

                const photos = [];

                function setToast(message, type) {
                    toast.textContent = message || "";
                    toast.className = "toast-message" + (type ? " " + type : "");
                }

                function updateCount() {
                    selectionCount.textContent = photos.length + " of " + MAX_PHOTOS + " photos";
                    statusBar.classList.toggle("limit-reached", photos.length >= MAX_PHOTOS);
                    submitBtn.hidden = photos.length === 0;
                }

                function createTile(previewUrl) {
                    const tile = document.createElement("div");
                    tile.className = "photo-tile";

                    const img = document.createElement("img");
                    img.src = previewUrl;
                    img.alt = "Selected photo preview";
                    tile.appendChild(img);

                    const deleteBtn = document.createElement("button");
                    deleteBtn.type = "button";
                    deleteBtn.className = "delete-tile-btn";
                    deleteBtn.setAttribute("aria-label", "Remove photo");
                    deleteBtn.innerHTML = "&times;";
                    tile.appendChild(deleteBtn);

                    photoGrid.appendChild(tile);
                    return { tile, deleteBtn };
                }

                function addPhoto(file) {
                    if (photos.length >= MAX_PHOTOS) return;

                    const previewUrl = URL.createObjectURL(file);
                    const { tile, deleteBtn } = createTile(previewUrl);

                    const entry = { tile, file, previewUrl };
                    photos.push(entry);
                    updateCount();

                    deleteBtn.addEventListener("click", () => removePhoto(entry));
                }

                function removePhoto(entry) {
                    const index = photos.indexOf(entry);
                    if (index === -1) return;

                    URL.revokeObjectURL(entry.previewUrl);
                    entry.tile.remove();
                    photos.splice(index, 1);
                    updateCount();
                }

                function handleFiles(fileList) {
                    const files = Array.from(fileList).filter((f) => f.type.startsWith("image/"));
                    if (files.length === 0) return;

                    const remaining = MAX_PHOTOS - photos.length;
                    if (remaining <= 0) {
                        setToast("You've reached the " + MAX_PHOTOS + "-photo limit.", "error");
                        return;
                    }

                    if (files.length > remaining) {
                        setToast("Only " + remaining + " more photo(s) can be added.", "error");
                    }

                    files.slice(0, remaining).forEach((file) => addPhoto(file));
                }

                async function uploadPhotos() {
                    if (photos.length === 0) return;

                    const guestName = guestNameInput.value.trim() || "Guest";

                    submitBtn.disabled = true;
                    submitBtn.classList.add("loading");
                    uploadProgress.style.display = "block";
                    progressFill.style.width = "0%";

                    try {
                        const photoData = [];
                        for (let i = 0; i < photos.length; i++) {
                            progressText.textContent = `Uploading photo ${i + 1} of ${photos.length}...`;
                            progressFill.style.width = `${((i + 1) / photos.length) * 100}%`;

                            const base64 = await fileToBase64(photos[i].file);
                            photoData.push(base64);
                        }

                        const response = await fetch("/GuestUpload?handler=Upload", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": getAntiforgeryToken()
                            },
                            body: JSON.stringify({
                                eventCode: EVENT_CODE,
                                guestName: guestName,
                                photoData: photoData
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            setToast("Photos uploaded successfully!", "success");
                            setTimeout(() => {
                                window.location.href = `/Guest/GuestEventGallery?code=${EVENT_CODE}`;
                            }, 1500);
                        } else {
                            setToast(result.message || "Upload failed. Please try again.", "error");
                            submitBtn.disabled = false;
                            submitBtn.classList.remove("loading");
                            uploadProgress.style.display = "none";
                        }
                    } catch (error) {
                        console.error(error);
                        setToast("Upload failed. Please check your connection.", "error");
                        submitBtn.disabled = false;
                        submitBtn.classList.remove("loading");
                        uploadProgress.style.display = "none";
                    }
                }

                function fileToBase64(file) {
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = () => resolve(reader.result);
                        reader.onerror = reject;
                        reader.readAsDataURL(file);
                    });
                }

                dropzone.addEventListener("click", () => fileInput.click());
                fileInput.addEventListener("change", (e) => {
                    handleFiles(e.target.files);
                    fileInput.value = "";
                });

                submitBtn.addEventListener("click", uploadPhotos);

                ["dragenter", "dragover"].forEach((evt) => {
                    dropzone.addEventListener(evt, (e) => {
                        e.preventDefault();
                        dropzone.classList.add("drag-over");
                    });
                });

                ["dragleave", "drop"].forEach((evt) => {
                    dropzone.addEventListener(evt, (e) => {
                        e.preventDefault();
                        dropzone.classList.remove("drag-over");
                    });
                });

                dropzone.addEventListener("drop", (e) => {
                    if (e.dataTransfer && e.dataTransfer.files) handleFiles(e.dataTransfer.files);
                });

                updateCount();
            }

            if (!isEventFound) {
                const scanBox = document.getElementById("scanBox");
                const scanCameraBtn = document.getElementById("scanCameraBtn");
                const cancelCameraBtn = document.getElementById("cancelCameraBtn");
                const cameraContainer = document.getElementById("cameraContainer");
                const cameraVideo = document.getElementById("cameraVideo");
                const cameraCanvas = document.getElementById("cameraCanvas");
                const qrFileInput = document.getElementById("qrFileInput");
                const eventCodeInput = document.getElementById("eventCodeInput");
                const manualEntryBtn = document.getElementById("manualEntryBtn");
                const statusMsg = document.getElementById("statusMsg");

                let cameraStream = null;
                let cameraLoopId = null;
                let isProcessing = false;

                function setStatus(message, type) {
                    statusMsg.textContent = message || "";
                    statusMsg.className = "toast-message" + (type ? " " + type : "");
                }

                async function submitQrData(qrData) {
                    if (isProcessing) return;
                    isProcessing = true;
                    setStatus("Checking QR code…");

                    try {
                        const response = await fetch("/GuestUpload?handler=Scan", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": getAntiforgeryToken()
                            },
                            body: JSON.stringify({ qrData })
                        });

                        const result = await response.json();

                        if (result.success && result.redirectUrl) {
                            setStatus("Event found! Directing to upload...", "success");
                            stopCamera();
                            window.location.href = result.redirectUrl;
                        } else {
                            setStatus(result.message || "Invalid QR code.", "error");
                            isProcessing = false;
                        }
                    } catch (err) {
                        setStatus("Something went wrong.", "error");
                        isProcessing = false;
                    }
                }

                manualEntryBtn.addEventListener("click", async function () {
                    const code = eventCodeInput.value.trim();
                    if (!code) {
                        setStatus("Please enter an event code.", "error");
                        return;
                    }

                    setStatus("Looking up event…");

                    try {
                        const response = await fetch("/GuestUpload?handler=Lookup", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": getAntiforgeryToken()
                            },
                            body: JSON.stringify({ eventCode: code })
                        });

                        const result = await response.json();

                        if (result.success && result.redirectUrl) {
                            window.location.href = result.redirectUrl;
                        } else {
                            setStatus(result.message || "Event not found.", "error");
                        }
                    } catch (err) {
                        setStatus("Something went wrong.", "error");
                    }
                });

                async function startCamera() {
                    cameraContainer.classList.add("is-active");
                    scanCameraBtn.style.display = "none";

                    try {
                        cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } });
                        cameraVideo.srcObject = cameraStream;
                        await cameraVideo.play();
                        requestAnimationFrame(scanFrame);
                    } catch (err) {
                        setStatus("Couldn't access the camera.", "error");
                        stopCamera();
                    }
                }

                function stopCamera() {
                    if (cameraLoopId) cancelAnimationFrame(cameraLoopId);
                    if (cameraStream) cameraStream.getTracks().forEach((track) => track.stop());
                    cameraVideo.srcObject = null;
                    cameraContainer.classList.remove("is-active");
                    scanCameraBtn.style.display = "";
                }

                function scanFrame() {
                    if (!cameraStream || isProcessing) return;

                    if (cameraVideo.readyState === cameraVideo.HAVE_ENOUGH_DATA) {
                        const ctx = cameraCanvas.getContext("2d");
                        cameraCanvas.width = cameraVideo.videoWidth;
                        cameraCanvas.height = cameraVideo.videoHeight;
                        ctx.drawImage(cameraVideo, 0, 0, cameraCanvas.width, cameraCanvas.height);

                        const imageData = ctx.getImageData(0, 0, cameraCanvas.width, cameraCanvas.height);
                        const code = window.jsQR(imageData.data, imageData.width, imageData.height);

                        if (code && code.data) {
                            submitQrData(code.data);
                            return;
                        }
                    }
                    cameraLoopId = requestAnimationFrame(scanFrame);
                }

                scanCameraBtn.addEventListener("click", startCamera);
                cancelCameraBtn.addEventListener("click", stopCamera);
            }
        })();
    </script>
</body>
</html>

