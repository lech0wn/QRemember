@page "/e/{code}"
@model QRemember.Web.Pages.Guest.IndexModel
@{
    ViewData["Title"] = Model.EventFound ? Model.EventName : "Event Not Found";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
    <style>
        /* ... existing styles ... */
        .btn-view-gallery {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 32px;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
        }
        .btn-view-gallery:hover {
            background: #A5834C;
        }
    </style>
</head>
<body>
    @if (Model.EventFound)
    {
        <div class="event-card">
            <h1>@Model.EventName</h1>
            <p class="event-date">@Model.EventDate.ToString("MMMM d, yyyy")</p>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="event-description">@Model.Description</p>
            }
            <form method="post" asp-page-handler="ViewGallery">
                <input type="hidden" name="code" value="@Model.EventCode" />
                <button type="submit" class="btn-view-gallery">View Gallery</button>
            </form>
        </div>
    }
    else if (Model.EventExpired)
    {
        <div class="event-card">
            <h1>This Event Has Expired</h1>
            <p class="event-description">This event's gallery is no longer available.</p>
        </div>
    }
    else
    {
        <div class="event-card">
            <h1>Event Not Found</h1>
            <p class="event-description">This QR code doesn't match an active event.</p>
        </div>
    }
</body>
</html>