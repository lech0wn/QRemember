@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --accent: #B8975A;
            --bg: #FAF9F6;
            --text: #1C1C1C;
            --muted: #8C8C8C;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            position: relative;
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: stretch;
            justify-content: center;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image: url('/images/auth-pic.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: grayscale(100%);
            z-index: -1;
        }

        .auth-panel {
            position: relative;
            width: 520px;
            max-width: 100%;
            min-height: 100vh;
            background: var(--bg);
            box-shadow: 0 0 70px rgba(0, 0, 0, 0.35);
            padding: 48px 64px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .back-btn {
            position: absolute;
            top: 24px;
            left: 24px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--text);
            color: var(--bg);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 16px;
            text-decoration: none;
        }

        .back-btn:hover {
            background: #333;
        }

        .brand {
            text-align: center;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            font-size: 22px;
            letter-spacing: 4px;
            color: var(--text);
            text-transform: uppercase;
            margin: 0 0 8px;
        }

        .logo {
            display: block;
            width: 150px;
            max-width: 60%;
            margin: 0 auto 8px;
        }

        h1.heading {
            text-align: center;
            font-family: 'Playfair Display', serif;
            font-weight: 500;
            font-size: 34px;
            color: var(--accent);
            margin: 0 0 12px;
        }

        .page-subtitle {
            text-align: center;
            font-size: 13px;
            color: var(--muted);
            margin: 0 0 28px;
            line-height: 1.5;
        }

        .validation-summary {
            color: #b00020;
            font-size: 13px;
            margin-bottom: 16px;
            text-align: center;
        }

        .form-group {
            margin-bottom: 26px;
        }

        .form-group label {
            display: block;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 10px;
        }

        .form-group input {
            width: 100%;
            border: none;
            border-bottom: 1px solid var(--muted);
            background: transparent;
            padding: 4px 2px 10px;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            color: var(--text);
            outline: none;
        }

        .form-group input::placeholder {
            color: #B8B8B2;
        }

        .form-group input:focus {
            border-bottom-color: var(--accent);
        }

        .btn-submit {
            width: 100%;
            padding: 15px;
            border: none;
            background: var(--text);
            color: var(--bg);
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 6px;
        }

        .btn-submit:hover {
            background: #333;
        }

        .links {
            margin-top: 22px;
            text-align: center;
        }

        .links a {
            display: block;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--muted);
            text-decoration: underline;
            margin-top: 14px;
        }

        .links a:hover {
            color: var(--text);
        }
    </style>
</head>
<body>
    <div class="auth-panel">
        <a asp-page="Login" class="back-btn" aria-label="Back to login">&#8592;</a>

        <div class="brand">QRemember</div>
        <img src="/images/logo.png" alt="QRemember logo" class="logo" />

        <h1 class="heading">Forgot Password</h1>
        <p class="page-subtitle">Enter your account email and we'll send you a 6-digit code to reset your password.</p>

        <form method="post">
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" type="email" placeholder="test@example.com" autofocus />
            </div>

            <button type="submit" class="btn-submit">Send Code</button>

            <div class="links">
                <a asp-page="Login">Back to log in</a>
            </div>
        </form>
    </div>
</body>
</html>
