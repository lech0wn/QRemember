@model UploadFormModel

<main>
    <h1 class="page-title">Share Photos</h1>
    <p class="page-subtitle">Upload your photos to <strong>@Model.EventName</strong></p>
    <div class="event-tag">#@Model.EventHashtag</div>

    <div class="form-group">
        <label class="field-label" for="guestName">Guest Name (Optional)</label>
        <span class="field-hint">Leave blank for anonymous contribution</span>
        <input type="text" id="guestName" class="guest-input" placeholder="Your name..." autocomplete="name" maxlength="80" />
    </div>

    <div class="dropzone-card" id="dropzone" tabindex="0" role="button" aria-label="Choose photos to upload">
        <svg class="dropzone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            <circle cx="12" cy="13" r="4"></circle>
        </svg>
        <span class="dropzone-title">CHOOSE PHOTOS</span>
        <span class="dropzone-sub">or drag & drop images here</span>
        <input type="file" id="fileInput" class="visually-hidden" accept="image/*" multiple />
    </div>

    <div class="status-bar" id="statusBar">
        <span id="selectionCount">0 of @Model.MaxPhotos photos</span>
        <a href="/Guest/GuestEventGallery?code=@Model.EventCode" class="gallery-link">View Gallery →</a>
    </div>

    <div class="photo-grid" id="photoGrid"></div>

    <button type="button" class="btn-primary" id="submitBtn" hidden>
        <span class="spinner"></span>
        <span class="btn-text">Submit Photos</span>
    </button>

    <div class="progress-container" id="uploadProgress" style="display:none;">
        <span id="progressText">Uploading...</span>
        <div class="progress-bar-bg">
            <div class="progress-fill" id="progressFill"></div>
        </div>
    </div>

    <p class="toast-message" id="toast" role="status" aria-live="polite"></p>
</main>